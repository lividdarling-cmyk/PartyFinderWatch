<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.3.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DalamudPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)</DalamudPath>
    <DalamudPath Condition="'$(DalamudPath)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks\dev</DalamudPath>
  </PropertyGroup>
  <ItemGroup>
    <DalamudReference Include="Dalamud;Dalamud.Bindings.ImGui;FFXIVClientStructs;InteropGenerator.Runtime;Lumina;Lumina.Excel" />
    <Reference Include="@(DalamudReference)">
      <HintPath>$(DalamudPath)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Update="PartyFinderWatch.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckDalamudLibraries" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DalamudPath)\Dalamud.dll')" Text="Dalamud development libraries could not be found in $(DalamudPath). Launch FFXIV with Dalamud or set DALAMUD_HOME." />
  </Target>
</Project>
